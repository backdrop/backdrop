<?php
/**
 * @file
 * Install, update and uninstall functions for the testing profile.
 */
/**
 * Implements hook_install().
 *
 * Perform actions to set up the site for this profile.
 *
 * @see system_install()
 */
function testing_install() {
  // Tests expect the node listing as the front page and change permissions
  // between requests, so disable page caching for predictable responses.
  config_set('system.core', 'site_frontpage', 'node');
  config_set('system.core', 'cache', 0);
}
